# Development uses SQLite automatically. Set DATABASE_URL for production.
APP_ENV=development
DATABASE_URL=sqlite:///./data/healthflow.db

# Optional MySQL production settings
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=change-me
MYSQL_DATABASE=healthflow

# Optional retrieval services
MILVUS_HOST=localhost
MILVUS_PORT=19530
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=change-me

# OpenAI-compatible vLLM endpoint
VLLM_HOST=localhost
VLLM_PORT=8000
VLLM_MODEL=qwen-vl-plus
VLLM_API_BASE=
VLLM_API_KEY=
EMBEDDING_MODEL=BAAI/bge-large-zh-v1.5
EMBEDDING_OFFLINE=true

# Only needed by local data-generation scripts; never commit a real key.
MINIMAX_API_KEY=
MINIMAX_MODEL=MiniMax-M2.7

API_HOST=0.0.0.0
API_PORT=8080
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
ROUTER_CONFIDENCE_THRESHOLD=0.55
MAX_RECURSION=3
MAX_UPLOAD_BYTES=20971520
MAX_UPLOAD_FILES=20
REPORT_PARSE_WORKERS=4

# Published knowledge-card matching service (set the key in private .env only).
GENESIS_EVIDENCE_API_URL=http://127.0.0.1:8125/api/evidence/matches
GENESIS_EVIDENCE_API_KEY=
GENESIS_EVIDENCE_TIMEOUT_SECONDS=30

# Mall third-party read-only goods endpoint (genesis-evidence #167).
# The APP_SECRET is a credential: inject it from the service environment file,
# never commit it and never log it. Missing any of the four settings degrades
# the recommendation block to "暂无推荐" instead of sending an unsigned request.
MALL_WEBAPI_BASE_URL=
MALL_WEBAPI_GOODS_PATH=/mallapi/webapi/goods/read
MALL_WEBAPI_APP_ID=
MALL_WEBAPI_APP_SECRET=
MALL_WEBAPI_TENANT_ID=
MALL_WEBAPI_TIMEOUT_SECONDS=10
MALL_WEBAPI_PAGE_SIZE=100

# Mall-issued one-time login ticket (genesis-evidence #168 issues, #171 verifies).
# The public key is delivered offline by the mall side; put its path here.
# Either value missing means the service REFUSES TO START -- a service that cannot
# verify but runs anyway looks like it has a gate when it does not.
MALL_TICKET_PUBLIC_KEY_PATH=
MALL_TICKET_AUDIENCE=
# Verifier-enforced upper bound on ticket lifetime (the mall issues 120s tickets).
MALL_TICKET_MAX_TTL_SECONDS=600

# Cart deep link (genesis-evidence #175). The storefront base URL and the cart
# route are deployment facts -- the H5 route prefix is NOT guessable from code.
# Missing any of the three means the link is refused rather than guessed.
MALL_STOREFRONT_BASE_URL=
MALL_STOREFRONT_CART_PATH=
MALL_DEEP_LINK_SECRET=

# Serve the built React app from the FastAPI process.
SERVE_FRONTEND=false
FRONTEND_DIST=frontend/dist
# RFC 7617 Basic authentication. Configure only behind HTTPS.
HEALTHFLOW_BASIC_USER=healthflow
HEALTHFLOW_BASIC_PASSWORD=
HEALTHFLOW_BASIC_AUTH_ENABLED=false

# Patient account sessions. Production should run behind HTTPS.
REPORT_ACCOUNT_REQUIRED=false
AUTH_SESSION_DAYS=30
AUTH_COOKIE_SECURE=false
