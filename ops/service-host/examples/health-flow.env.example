# HealthFlow on a service host.
# Copy to /opt/health-flow/var/health-flow.env, mode 640, owned by the service
# identity. Never commit a real value.
#
# `APP_ENV` is **not** a database switch. Production selects MySQL only when
# `DATABASE_URL` is empty; it is set explicitly below, so that branch is
# unreachable here and the SQLite tenant is used whichever value this has.
#
# What the value actually decides:
#
#   - `report_account_required` and `auth_cookie_secure` take their defaults
#     from it. Both are written explicitly below, so those defaults are not
#     consulted — and the security posture does not change when someone edits a
#     variable that also names the deployment's *environment*. See the note on
#     `AUTH_COOKIE_SECURE`.
#   - `/ready`'s `mall_goods`: under production an unconfigured mall block is
#     reported as `missing` (a configuration fault) rather than `unconfigured`
#     (a legitimate development setup).
APP_ENV=development

# Set explicitly: an empty new tenant uses this SQLite file, and this is what
# keeps the production branch of `database_url` out of the picture.
DATABASE_URL=sqlite:////opt/health-flow/var/healthflow.db

# The report provider. The application starts and accepts uploads without it,
# but report extraction uses a fallback key and fails authentication, so the
# worker cannot process anything. /ready reports this as
# report_provider: unconfigured.
OPENAI_RESPONSES_URL=https://api.psydo.top/v1/responses
OPENAI_API_KEY=replace-with-the-provider-key
VLLM_MODEL=gpt-5.6-sol

SERVE_FRONTEND=true
FRONTEND_DIST=/opt/health-flow/frontend
REPORT_FILES_DIR=/opt/health-flow/var/report-files

REPORT_ACCOUNT_REQUIRED=true
# Set explicitly rather than inheriting it from `APP_ENV`. The incident this
# guards against is a default that changed silently: `auth_cookie_secure`
# derives True from `APP_ENV=production`, and the live deployment runs
# `APP_ENV=development`, so the derived value is False. Writing the value here
# makes "this deployment requires Secure" a fact a reader can see in the file.
# It must be `true` wherever the portal is reached over HTTPS — a plain
# `http://` route would silently fail to store the cookie and log the patient
# out, which is the failure shape recorded in genesis-evidence #328.
AUTH_COOKIE_SECURE=true

# The current text version of each health-data consent (ADR 0027). A patient
# agreed to *a version of the text*; changing a value here invalidates every
# earlier agreement for that item and the patient is asked again. That is the
# purpose, not a side effect. Two items, two values: a new report-interpretation
# text must not void the patient's answer on product recommendations.
# Draft ids during development; replace them when legal signs the text off.
CONSENT_REPORT_INTERPRETATION_VERSION=draft-2026-10-27
CONSENT_PRODUCT_RECOMMENDATION_VERSION=draft-2026-10-27

# The evidence service on THIS host, not the development host.
GENESIS_EVIDENCE_API_URL=http://127.0.0.1:10005/api/evidence/matches
GENESIS_EVIDENCE_METRICS_URL=http://127.0.0.1:10005/api/metrics
GENESIS_EVIDENCE_API_KEY=replace-with-the-same-key-the-evidence-service-uses
GENESIS_EVIDENCE_TIMEOUT_SECONDS=30
