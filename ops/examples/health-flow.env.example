APP_ENV=development
DATABASE_URL=sqlite:////home/claude/Projects/health-flow/data/healthflow.db
VLLM_MODEL=gpt-5.6-sol
OPENAI_API_KEY=replace-with-the-provider-key
OPENAI_RESPONSES_URL=https://api.psydo.top/v1/responses
# 视觉抽取的输出预算。报告一页的指标 JSON 轻易超过 4k token；用推理模型时它们先输出
# reasoning 再给正文、共用这一个预算，8192 常被吃光（实测需要 16384），表现为
# 「VLM 未返回 JSON」——看起来像模型不配合，实际是输出被截断在 JSON 中间。
REPORT_EXTRACTION_MAX_TOKENS=16384
REPORT_PARSE_WORKERS=4
REPORT_PARSE_TIMEOUT_SECONDS=180
REPORT_JOB_STALE_SECONDS=1200
REPORT_WORKER_POLL_SECONDS=2
MAX_UPLOAD_TOTAL_BYTES=52428800
SERVE_FRONTEND=true
FRONTEND_DIST=/home/claude/Projects/health-flow/frontend/dist
HEALTHFLOW_BASIC_USER=healthflow
HEALTHFLOW_BASIC_PASSWORD=change-me
# Optional operator-only compatibility gate. Patient access uses account sessions.
HEALTHFLOW_BASIC_AUTH_ENABLED=false
REPORT_ACCOUNT_REQUIRED=true
AUTH_SESSION_DAYS=30
# Set false only for local HTTP; production HTTPS should keep the default true.
AUTH_COOKIE_SECURE=true
GENESIS_EVIDENCE_API_URL=http://127.0.0.1:8125/api/evidence/matches
GENESIS_EVIDENCE_API_KEY=replace-with-the-same-long-random-key-as-evidence-service
GENESIS_EVIDENCE_TIMEOUT_SECONDS=30
# Mall third-party read-only goods endpoint. Leave the block empty to run
# without recommendations (the page degrades to "暂无推荐"); a partial block
# is treated as unconfigured on purpose, so an unsigned request is never sent.
MALL_WEBAPI_BASE_URL=https://lkf.h5.mall.qushiyun.com
MALL_WEBAPI_APP_ID=
MALL_WEBAPI_APP_SECRET=
MALL_WEBAPI_TENANT_ID=
MALL_WEBAPI_TIMEOUT_SECONDS=10

# Mall-issued one-time login ticket (genesis-evidence #168 issues, #171 verifies).
# The public key is delivered offline by the mall side; put its path here.
# Either value missing means the service REFUSES TO START -- a service that cannot
# verify but runs anyway looks like it has a gate when it does not.
MALL_TICKET_PUBLIC_KEY_PATH=
MALL_TICKET_AUDIENCE=
# Verifier-enforced upper bound on ticket lifetime (the mall issues 120s tickets).
MALL_TICKET_MAX_TTL_SECONDS=600
MALL_STOREFRONT_BASE_URL=
MALL_STOREFRONT_CART_PATH=
MALL_DEEP_LINK_SECRET=
